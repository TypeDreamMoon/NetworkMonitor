<UserControl
    x:Class="NetworkMonitor.WinUI.Controls.ProcessTrafficView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:NetworkMonitor.WinUI.Controls">

    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,2,0,0">
            <Image Source="ms-appx:///Assets/Icons/process_818CF8.svg" Width="16" Height="16" />
            <TextBlock Text="进程流量" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>

        <Grid>
            <TextBlock x:Name="StatusText" Text="正在启动进程流量采集…" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="330" />
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleSwitch x:Name="CaptureToggle" MinWidth="0" OnContent="采集" OffContent="已暂停"
                              VerticalAlignment="Center" Toggled="Capture_Toggled" />
                <Button Content="刷新" Style="{StaticResource TitleIconButton}" Width="44"
                        VerticalAlignment="Center" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}">
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock x:Name="ScopeLabel" Text="今日进程流量" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" />
                    <toolkit:Segmented x:Name="ScopeSegment" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       SelectedIndex="0" SelectionChanged="Scope_Changed">
                        <toolkit:SegmentedItem Content="今日" />
                        <toolkit:SegmentedItem Content="本周" />
                        <toolkit:SegmentedItem Content="本月" />
                    </toolkit:Segmented>
                </Grid>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Image Source="ms-appx:///Assets/Icons/downcircle_3EDCC4.svg" Width="12" Height="12" />
                            <TextBlock Text="区间流量" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <TextBlock x:Name="TotalText" Text="—" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource DownBrush}" />
                        <TextBlock x:Name="TotalSplit" Text="↓ —   ↑ —" Style="{StaticResource MutedText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Image Source="ms-appx:///Assets/Icons/upcircle_FFB454.svg" Width="12" Height="12" />
                            <TextBlock Text="本次运行" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <TextBlock x:Name="SessionText" Text="—" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource UpBrush}" />
                        <TextBlock x:Name="SessionSplit" Text="↓ —   ↑ —" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="EmptyHint" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <Border x:Name="PieCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="ms-appx:///Assets/Icons/process_818CF8.svg" Width="13" Height="13" />
                    <TextBlock Text="分类占比" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:DonutChart x:Name="CategoryPie" Width="132" Height="132" />
                    <StackPanel x:Name="PieLegend" Grid.Column="1" Spacing="5" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,4,0,0">
            <Image Source="ms-appx:///Assets/Icons/process_818CF8.svg" Width="13" Height="13" />
            <TextBlock Text="按进程" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="CountLabel" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel x:Name="AppsPanel" Spacing="6" />

        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,8,0,0"
                   Text="数据来自系统内核 ETW 事件（Microsoft-Windows-Kernel-Network），统计所有进程的真实收发字节，不依赖 FlClash；已排除回环、局域网与链路本地地址。" />
    </StackPanel>
</UserControl>
